datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  ADMIN
  LOGISTICS_OPERATOR
  TRANSPORTER
}

enum DischargePort {
  DAR_ES_SALAAM
  MOMBASA
}

enum BlType {
  SEA_WAYBILL
  ORIGINAL
}

enum RwandanDestination {
  NYANZA_KICUKIRO
  RWAMAGANA_INDUSTRIAL_ZONE
}

enum ShipmentStatus {
  SHIPPED_ON_BOARD
  IN_TRANSIT_SEA
  ARRIVED_PORT_OF_DISCHARGE
  CUSTOMS_PROCESSING
  CUSTOMS_CLEARED
  LOADED_ROAD_TRANSIT
  ARRIVED_DESTINATION
  OFFLOADED
  COMPLETED
}

enum ContainerStatus {
  ON_VESSEL
  DISCHARGED_AT_PORT
  IN_TRANSIT_TRUCK
  DELIVERED_WAREHOUSE
  OFFLOADED
  EMPTY_RETURNED_TO_DEPOT
}

enum DocumentStage {
  ENTRY_LEVEL
  PORT_CLEARANCE
  ROAD_TRANSIT
  FINAL_CLEARANCE
}

enum DocumentType {
  COMMERCIAL_INVOICE
  PACKING_LIST
  BILL_OF_LADING
  CERTIFICATE_OF_ANALYSIS
  CUSTOMS_WH7
  CUSTOMS_T1
  CUSTOMS_IM4
  TRANSPORTER_RATE_AGREEMENT
  DESTINATION_CLEARANCE
  DELIVERY_NOTE
}

enum NotificationChannel {
  SYSTEM
  WHATSAPP
  BOTH
}

// -------------------------------------------------------------
// USER & RBAC
// -------------------------------------------------------------

model User {
  id       String @id @default(uuid())
  email    String @unique
  name     String
  phone    String // Standard E.164 format for WhatsApp notifications
  password String // bcrypt hash, used by the Credentials auth provider

  role      UserRole @default(LOGISTICS_OPERATOR)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedShipments Shipment[]      @relation("TransporterShipments")
  createdShipments  Shipment[]      @relation("OperatorCreatedShipments")
  uploadedDocuments  Document[]
  notifications      Notification[]
  auditLogs          ShipmentAudit[]
  truckStatusUpdates TruckStatusUpdate[]

  @@index([role])
}

// -------------------------------------------------------------
// CORE SHIPMENT & BL
// -------------------------------------------------------------

model Shipment {
  id                   String              @id @default(uuid())
  blNumber             String              @unique
  blType               BlType              @default(ORIGINAL)
  shippingLine         String // e.g. MSC
  vesselName           String? // e.g. MSC ASYA
  voyageNumber         String? // e.g. MA622R
  bookingRef           String?
  originCountry        String // India, China, UAE, USA, Indonesia, etc.
  originPort           String? // e.g. ENNORE, INDIA
  dischargePort        DischargePort // DAR_ES_SALAAM or MOMBASA
  destinationWarehouse RwandanDestination? // NYANZA_KICUKIRO or RWAMAGANA_INDUSTRIAL_ZONE

  shipperName   String?
  consigneeName String?
  notifyParty   String?

  shippedOnBoardDate  DateTime?
  currentEta          DateTime // Maintained and updated daily
  actualDischargeDate DateTime?

  // Road transit to the Rwandan destination warehouse (LOADED_ROAD_TRANSIT)
  transitStartedAt  DateTime?
  transitArrivalEta DateTime?

  // Import tax / duty payment (recorded independently of status)
  isTaxPaid     Boolean   @default(false)
  taxPaidAt     DateTime?
  taxLocation   String? // e.g. "Mombasa Port Customs"
  taxReceivedBy String? // name of the receiving officer/agent
  taxAmount     Decimal?  @db.Decimal(12, 2)
  taxCurrency   String?   @default("USD")

  status ShipmentStatus @default(IN_TRANSIT_SEA)

  // Transporter Commercial Details
  transporterId        String?
  transporter          User?     @relation("TransporterShipments", fields: [transporterId], references: [id])
  agreedTransportPrice Decimal?  @db.Decimal(12, 2)
  currency             String    @default("USD")
  priceAgreedAt        DateTime?
  isLoadedOnTruck      Boolean   @default(false)

  // System Flags
  sevenDayAlertSent Boolean @default(false)

  createdById String
  createdBy   User   @relation("OperatorCreatedShipments", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  containers    Container[]
  documents     Document[]
  stageAgents   StageAgent[]
  notifications Notification[]
  auditLogs     ShipmentAudit[]

  @@index([blNumber])
  @@index([status])
  @@index([currentEta])
}

// -------------------------------------------------------------
// CONTAINERS & INVENTORY
// -------------------------------------------------------------

model Container {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  containerNumber String
  containerType   String  @default("40_HIGH_CUBE")
  sealNumber      String?
  tareWeightKg    Decimal? @db.Decimal(10, 2)
  grossWeightKg   Decimal? @db.Decimal(10, 2)
  volumeCbm       Decimal? @db.Decimal(10, 2)

  inventoryReference String // e.g. "Woodfree Paper in Reels"
  itemQuantity       Int?

  status             ContainerStatus @default(ON_VESSEL)
  offloadScheduledAt DateTime?
  actualOffloadedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  detentionTracker    DetentionTracker?
  transitDetails      ContainerTransitDetails?
  truckStatusUpdates  TruckStatusUpdate[]

  @@unique([shipmentId, containerNumber])
  @@index([containerNumber])
}

// -------------------------------------------------------------
// 30-DAY DETENTION TRACKING
// -------------------------------------------------------------

model DetentionTracker {
  id          String    @id @default(uuid())
  containerId String    @unique
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  freeTimeDays        Int       @default(30)
  clockStartDate      DateTime? // Timestamp when discharged at seaport
  deadlineDate        DateTime? // clockStartDate + 30 days
  returnedToDepotDate DateTime?

  day15AlertSent Boolean @default(false)
  day22AlertSent Boolean @default(false)
  day28AlertSent Boolean @default(false)
  isOverdue      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deadlineDate])
  @@index([isOverdue])
}

// -------------------------------------------------------------
// STAGE-WISE ATTACHMENTS
// -------------------------------------------------------------

model Document {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // Structured checklist documents set both stage and type; ad-hoc general
  // documents (uploaded from the "General Documents" section) leave both
  // null and set a free-text title instead.
  stage    DocumentStage?
  type     DocumentType?
  title    String?
  comment  String?
  fileUrl  String
  fileName String
  fileSize Int
  mimeType String

  // WH7/T1/IM4 declaration number -- only meaningful for those document
  // types, set at upload time alongside the file itself.
  referenceNumber String?

  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId, stage])
}

// The clearing/handling agent for one document stage of a shipment (e.g.
// the customs broker for Stage 2). One shipment can have a different agent
// per stage, so this is keyed by (shipmentId, stage) rather than living
// directly on Shipment.
model StageAgent {
  id         String        @id @default(uuid())
  shipmentId String
  shipment   Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  stage      DocumentStage

  name     String
  contact  String
  position String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shipmentId, stage])
}

// Road transit dispatch details for Stage 2 (one record per container --
// different containers on the same shipment can go out on different
// trucks/drivers, so this is keyed off Container, not Shipment).
model ContainerTransitDetails {
  id          String    @id @default(uuid())
  containerId String    @unique
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  transporterName  String
  assignmentDate   DateTime?
  loadingDate      DateTime?
  truckDetails     String?
  driverDetails    String?
  journeyStartDate DateTime?

  drivers TransitDriver[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A driver assigned to a container's truck -- a truck can have more than
// one over the journey (e.g. a primary and a relief driver), so this is a
// list off ContainerTransitDetails rather than a couple of flat columns.
model TransitDriver {
  id                        String                  @id @default(uuid())
  containerTransitDetailsId String
  containerTransitDetails   ContainerTransitDetails @relation(fields: [containerTransitDetailsId], references: [id], onDelete: Cascade)

  name  String
  phone String?

  createdAt DateTime @default(now())
}

// A single checkpoint in a container's road-transit journey for Stage 3 --
// one container can have many of these over time, building up a timeline
// (e.g. "Departed port", "Border crossing", "Arrived warehouse"). Keyed off
// Container, not Shipment, for the same reason as ContainerTransitDetails.
model TruckStatusUpdate {
  id          String    @id @default(uuid())
  containerId String
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  location  String
  timestamp DateTime
  notes     String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([containerId, timestamp])
}

// A running list of trucking companies typed into Transit Details, so
// previously-used names can be picked from a searchable list instead of
// retyped. Grows organically -- there's no separate "manage transporters"
// screen, a name is added the first time someone types it.
model TransportCompany {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// -------------------------------------------------------------
// NOTIFICATIONS & AUDITS
// -------------------------------------------------------------

model Notification {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  title   String
  message String
  channel NotificationChannel @default(BOTH)
  isRead  Boolean             @default(false)

  waMessageSid String?
  waSentAt     DateTime?
  waStatus     String?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// Extra numbers (not tied to a User account) that receive a copy of every
// WhatsApp notification the system sends, e.g. an ops manager's phone.
model WhatsAppRecipient {
  id          String   @id @default(uuid())
  label       String
  phoneNumber String   @unique // E.164 format
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ShipmentAudit {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   String
  oldValue Json?
  newValue Json?

  createdAt DateTime @default(now())

  @@index([shipmentId])
}
